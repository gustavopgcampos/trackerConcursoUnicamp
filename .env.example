# ─────────────────────────────────────────────────────────────────────────────
# Monitor de Concursos Públicos - UNICAMP
# Copie este arquivo para ".env" e preencha com seus dados reais.
# ─────────────────────────────────────────────────────────────────────────────

# ── Servidor SMTP ─────────────────────────────────────────────────────────────
# Gmail (padrão):
SMTP_HOST=
SMTP_PORT=

# Outlook/Hotmail:
# SMTP_HOST=smtp.office365.com
# SMTP_PORT=587

# ── Conta remetente ───────────────────────────────────────────────────────────
EMAIL_FROM=

# Para Gmail com autenticação de 2 fatores ativada, use uma Senha de App:
# 1. Acesse: https://myaccount.google.com/apppasswords
# 2. Gere uma senha para "Outro (nome personalizado)"
# 3. Cole aqui abaixo (sem espaços)
EMAIL_PASSWORD=

# ── Destinatários ─────────────────────────────────────────────────────────────
# Separe múltiplos e-mails com vírgula
EMAIL_TO=

# ── Intervalo de verificação ──────────────────────────────────────────────────
# Em minutos. Padrão: 60 (verificar a cada hora)
# Não use valores muito baixos para não sobrecarregar o servidor da UNICAMP.
CHECK_INTERVAL_MINUTES=1440
